# Required for the Anthropic provider (default).
ANTHROPIC_API_KEY=sk-ant-...

# Required for the Inception Labs Mercury provider (diffusion).
# Sign up at https://platform.inceptionlabs.ai — 10M free tokens at signup.
# Only needed if you flip the top-bar toggle to Mercury.
INCEPTION_API_KEY=

# Optional model overrides — defaults are Haiku 4.5 (paragraph) and Sonnet 4.6 (document).
# WW_PARAGRAPH_MODEL=
# WW_DOCUMENT_MODEL=

# Optional Mercury model overrides — default mercury-2 for both passes.
# WW_INCEPTION_PARAGRAPH_MODEL=
# WW_INCEPTION_DOCUMENT_MODEL=
